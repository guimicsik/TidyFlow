<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0" ExtensionBundleId="com.tidyflow" ExtensionBundleVersion="1.0.0" ExtensionBundleName="TidyFlow" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.tidyflow" Version="1.0.0" />
    <Extension Id="com.tidyflow.editor" Version="1.0.0" />
    <Extension Id="com.tidyflow.collect" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[16.0,99.9]" />
      <Host Name="PPRO" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.tidyflow">
      <DispatchInfo>
        <Resources>
          <MainPath>http://localhost:5173/index.html</MainPath>
          <ScriptPath>./host/organizer.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-insecure-localhost</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>TidyFlow (dev)</Menu>
          <Geometry>
            <Size>
              <Height>460</Height>
              <Width>360</Width>
            </Size>
            <MinSize>
              <Height>460</Height>
              <Width>360</Width>
            </MinSize>
            <MaxSize>
              <Height>460</Height>
              <Width>360</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.tidyflow.editor">
      <DispatchInfo>
        <Resources>
          <MainPath>http://localhost:5173/tree_editor.html</MainPath>
          <ScriptPath>./host/organizer.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-insecure-localhost</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>TidyFlow - Preset Builder (dev)</Menu>
          <Geometry>
            <Size>
              <Height>750</Height>
              <Width>800</Width>
            </Size>
            <MinSize>
              <Height>750</Height>
              <Width>800</Width>
            </MinSize>
            <MaxSize>
              <Height>750</Height>
              <Width>800</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.tidyflow.collect">
      <DispatchInfo>
        <Resources>
          <MainPath>http://localhost:5173/collect.html</MainPath>
          <ScriptPath>./host/organizer.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-insecure-localhost</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>TidyFlow - Collect Files (dev)</Menu>
          <Geometry>
            <Size>
              <Height>700</Height>
              <Width>600</Width>
            </Size>
            <MinSize>
              <Height>700</Height>
              <Width>600</Width>
            </MinSize>
            <MaxSize>
              <Height>700</Height>
              <Width>600</Width>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>

